Options -Indexes

<FilesMatch "^(config\.local|config)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: https://accounts.google.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' blob: https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# DB kopija (.sql.gz) jau suspausta: hosto mod_deflate ja suspausdavo antra
# karta ir nuimdavo Content-Length (narsykle nerode progreso). (2026-10-07)
# ap_trust_cgilike_cl: Apache >= 2.4.59 (CVE-2024-24795) nepasitiki PHP-FPM
# Content-Length; db_backup_download() siuncia tikslu B2 dydi, todel ijungiamas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)action=db_backup_download(&|$)
  RewriteRule ^ - [E=no-gzip:1,E=dont-vary:1,E=ap_trust_cgilike_cl:1]
</IfModule>
