<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Vary: is cia nepataisoma - patikrinta 2026-09-04.
  #
  # Apache prie kiekvieno atsakymo prikabina "Vary: Accept-Encoding,User-Agent".
  # Nei viena sio puslapio dalis nuo narsykles nepriklauso (img.php formata ima
  # is fmt= parametro), o UA kenkia: jo eilute keiciasi su kiekvienu Chrome
  # atnaujinimu, ir kartu keiciasi narsykles podelio raktas - naudotojas kas
  # menesi is naujo atsisiunčia visas miniatiuras.
  #
  # Bandyta "Header set Vary", paskui "Header always unset" + "Header always
  # set". Nei viena nepadejo, nors X-Foto-Htaccess zymeklis irodo, kad sis
  # failas serveryje ir mod_headers direktyvos veikia: "User-Agent" prikabinamas
  # veliau, isvesties filtru grandineje, kurios is .htaccess nepasieksi.
  #
  # Todel tai daroma Cloudflare pusėje - Response Header Transform Rule, "Set
  # static" Vary = Accept-Encoding, taikoma foto.klajunas.lt. Jei Cloudflare kada
  # butu isjungtas, Vary grizs blogas, o miniatiuros vel pradės keliauti is naujo.

  Header always set X-Foto-Htaccess "2026-09-04"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

<FilesMatch "^(config\.php|patch-.*\.php|.*\.bak.*|img\.new\.php|gallery-security\.php)$">
  Require all denied
</FilesMatch>

# Galerija anksčiau gyveno /klajunas-gallery.html. Failas pašalintas (buvo
# baitas į baitą identiškas index.html ir jį reikėdavo atnaujinti dukart), o
# senos nuorodos nuolatiniu nukreipimu vedamos į pagrindinį puslapį.
Redirect 301 /klajunas-gallery.html /

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dalinamos albumo nuorodos: /a/<slug> -> og.php (bot'ams OG kortelė,
  # žmonėms redirect į SPA /?a=<slug>). QSA praleidžia ?f=N nuotraukos numerį.
  RewriteRule ^a/(.+)$ og.php?a=$1 [L,QSA]
  # Sitemap generuojamas dinamiškai iš DB manifesto.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
