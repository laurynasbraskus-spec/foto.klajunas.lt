<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Apache prie kiekvieno atsakymo prikabina "Vary: Accept-Encoding,User-Agent".
  # Nei viena sio puslapio dalis nuo narsykles nepriklauso - nei img.php
  # (formatas nurodomas fmt= parametru), nei og.php, - todel UA ten tik kenkia:
  # kiekvienas Chrome atnaujinimas keicia UA eilute, o su ja ir podelio rakta,
  # tad naudotojas kas menesi is naujo atsisiunčia visas miniatiuras.
  #
  # Butinai "always", ne paprastas "set". mod_headers turi dvi lenteles:
  # paprastos direktyvos raso i headers_out, o "always" - i err_headers_out, ir
  # i atsakyma patenka abi. Serverio lygio direktyva, kabinanti User-Agent,
  # naudoja "always", todel musu ankstesnis "Header set" jos neperrase - abi
  # tiesiog susidejo. Ta pacia lentele naudojanti .htaccess direktyva taikoma
  # veliau ir laimi.
  Header always unset Vary
  Header always set Vary "Accept-Encoding"

  # Zymeklis: pagal ji matyti, ar serveryje guli si .htaccess versija. Be jo
  # nebuvo kaip atskirti "failas neikeltas" nuo "ikeltas, bet direktyva
  # neveikia" - o tai du visai skirtingi dalykai.
  Header always set X-Foto-Htaccess "2026-10-08v"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Hosto Apache (mod_deflate, serverio lygio SetOutputFilter) suspaudzia visus
# .php atsakymus, net JPEG; serverio isimtis tik .jpg/.png pletiniams. Del to
# download.php/img.php ateidavo su gzip ir be Content-Length. no-gzip isjungia
# suspaudima, dont-vary nuima "User-Agent" is Vary. (2026-10-07)
# ap_trust_cgilike_cl: Apache >= 2.4.59 (CVE-2024-24795) nepasitiki PHP-FPM
# Content-Length ir siuncia chunked - narsykle nerodo progreso. Sie du
# skriptai siuncia tikslu dydi (readfile + exit), todel jiems pasitikejimas
# ijungiamas. Patikrinta testiniu aplanku 2026-10-07.
# video.php (2026-10-08) - Content-Length/Content-Range is B2 atsakymo, tikslus.
SetEnvIfNoCase Request_URI "^/(download|img|video)\.php$" no-gzip dont-vary ap_trust_cgilike_cl=1

<FilesMatch "^(config\.php|patch-.*\.php|.*\.bak.*|img\.new\.php|gallery-security\.php)$">
  Require all denied
</FilesMatch>

# Galerija anksčiau gyveno /klajunas-gallery.html. Failas pašalintas (buvo
# baitas į baitą identiškas index.html ir jį reikėdavo atnaujinti dukart), o
# senos nuorodos nuolatiniu nukreipimu vedamos į pagrindinį puslapį.
Redirect 301 /klajunas-gallery.html /

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dalinamos albumo nuorodos: /a/<slug> -> og.php (bot'ams OG kortelė,
  # žmonėms redirect į SPA /?a=<slug>). QSA praleidžia ?f=N nuotraukos numerį.
  RewriteRule ^a/(.+)$ og.php?a=$1 [L,QSA]
  # Sitemap generuojamas dinamiškai iš DB manifesto.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
